{
  "expo": {
    "name": "Peekfoot: Akıllı Moda & Lens",
    "slug": "peekfoot-fashion-lens",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.peekfoot.fashionlens",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Kıyafet ve kombin taramak için galeri erişimi gereklidir.",
          "cameraPermission": "Anlık ürün taramak için kamera erişimi gereklidir."
        }
      ],
      "./sdk24.js"
    ],
    "extra": {
      "eas": {
        "projectId": "3de525af-c594-4b44-ac66-46d66b72d82b"
      }
    },
    "splash": {
      "backgroundColor": "#ffffff"
    }
  }
}